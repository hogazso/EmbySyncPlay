<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Élő teszten kiderült (2026-09-28, NAS): az Emby NEM szállítja a Newtonsoft.Json-t
         a pluginjai mellé (FileNotFoundException a szerver indulásakor) — a class library
         alapból nem másolja ki a NuGet-függőségeket a kimenetbe, ezt kell kikényszeríteni,
         hogy a Newtonsoft.Json.dll-t is telepíteni tudjuk a plugin DLL mellé. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- A NAS-on futó élő Emby szerver 4.10.0.40-es — ez a legújabb NuGet-en elérhető
         verzió, ami ehhez a legközelebb áll (4.10.0.40 maga nincs publikálva csomagként). -->
    <PackageReference Include="mediabrowser.server.core" Version="4.10.0.24-beta" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Az Emby SDK (IResponse.OutputWriter, egyes IUserManager túlterhelések) ezekre
         hivatkozik a saját publikus felületén, netstandard2.0 alatt explicit kell. -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- A Web/ tartalom beágyazva kerül a DLL-be, hogy a plugin egyetlen fájlból telepíthető legyen. -->
    <EmbeddedResource Include="Web\syncplay.js" />
    <EmbeddedResource Include="Web\syncplay.html" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy &quot;$(TargetPath)&quot; &quot;%25AppData%25\Emby-Server\programdata\plugins\&quot; /y" Condition="'$(OS)' == 'Windows_NT'" />
  </Target>

</Project>
